{
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "files": {
    "includes": ["!**/public/safari-pinned-tab.svg"]
  },
  "formatter": {
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "rules": {
      "complexity": {
        "noVoid": "off"
      },
      "performance": {
        "noBarrelFile": "off",
        "noJsxPropsBind": "off"
      },
      "style": {
        "noEnum": "off",
        "useConsistentTypeDefinitions": "off",
        "useFilenamingConvention": "off"
      }
    }
  }
}
