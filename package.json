{
  "name": "f2e-2022",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --no-cache --parallel --continue",
    "build:docs": "turbo run build --filter=docs",
    "build:animated-landing": "turbo run build --filter=animated-landing",
    "build:pdf": "turbo run build --filter=pdf",
    "build:scrum": "turbo run build --filter=scrum",
    "dev:docs": "turbo run dev --filter=docs --no-cache --parallel --continue",
    "dev:animated-landing": "turbo run dev --filter=animated-landing --no-cache --parallel --continue",
    "dev:pdf": "turbo run dev --filter=pdf --no-cache --parallel --continue",
    "dev:scrum": "turbo run dev --filter=scrum --no-cache --parallel --continue",
    "start:docs": "turbo run start --filter=docs",
    "start:animated-landing": "turbo run start --filter=animated-landing",
    "start:pdf": "turbo run start --filter=pdf",
    "start:scrum": "turbo run start --filter=scrum",
    "check": "ultracite check",
    "knip": "knip",
    "typecheck": "turbo run typecheck",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "ultracite fix",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install --lockfile-only",
    "release": "turbo run build --filter=docs^... && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@happy-dom/global-registrator": "^20.11.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "knip": "^6.29.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-html-props": "^2.1.1",
    "turbo": "^2.10.7",
    "typescript": "^7.0.2",
    "ultracite": "7.9.4"
  }
}
